# Домен, на который смотрит DNS-запись сервера (для локального запуска: localhost)
DOMAIN=localhost

# Сгенерируйте: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Сгенерируйте: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Первый администратор создаётся при первом запуске, если админов ещё нет
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Лимиты для сервиса конференций (чтобы не мешать другим проектам на сервере)
APP_CPUS=2
APP_MEMORY=1g

# Порт на 127.0.0.1, куда ваш nginx/прокси будет проксировать сайт
APP_PORT=8080

# Публичный IP сервера: его увидят браузеры в WebRTC-кандидатах (обязательно на VPS)
PUBLIC_IP=
# UDP-порт для звука и видео (откройте его в файрволе)
RTC_UDP_PORT=50000
# Общий секрет приложения и coturn. Сгенерируйте: openssl rand -hex 32
TURN_SECRET=change-me-turn-secret

# Сколько дней хранить архив чата после завершения комнаты
CHAT_RETENTION_DAYS=60

# Только для запуска на отдельном порту (docker-compose.own-port.yml), см. DEPLOY.md
# HTTPS_PORT=8443
# TLS_CERT_DIR=/etc/letsencrypt
# TLS_CERT_PATH=live/example.com/fullchain.pem
# TLS_KEY_PATH=live/example.com/privkey.pem
# APP_USER=0:0
